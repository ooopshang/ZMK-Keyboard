#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

&lt { tapping-term-ms = <190>; flavor = "tap-preferred"; };

/ {
    behaviors {
        hl: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 30>;
            hold-trigger-on-release;
        };
        hr: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25>;
            hold-trigger-on-release;
        };
        winspace: space_or_tab {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp TAB>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T             &kp Y &kp U &kp I &kp O &hr RGUI P
                &hl LGUI A &hl LALT S &hl LCTRL D &hl LSHIFT F &kp G   &kp H &hr RSHIFT J &hr RCTRL K &hr LALT L &kp BSPC
                &kp Z &kp X &kp C &kp V &kp B   &winspace   &kp N &kp M &lt 1 COMMA &lt 2 DOT &kp ENTER
            >;
        };
        navigation {
            bindings = <
                &kp ESC &kp TAB &kp HOME &kp END &kp PG_UP       &kp LG(LS(S)) &kp LG(L) &kp LC(LS(ESC)) &kp LA(SPACE) &kp DEL
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_DN     &kp LSHIFT &kp LCTRL &kp LALT &kp LGUI &kp BSPC
                &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LG(SPACE)   &kp SPACE   &kp LC(LS(LEFT)) &kp LC(LS(RIGHT)) &trans &mo 3 &kp ENTER
            >;
        };
        numbers {
            bindings = <
                &kp N7 &kp N8 &kp N9 &kp LPAR &kp RPAR        &kp LBKT &kp RBKT &kp SLASH &kp BSLH &kp GRAVE
                &kp N4 &kp N5 &kp N6 &kp LBRC &kp RBRC        &kp MINUS &kp EQUAL &kp SQT &kp SEMI &kp BSPC
                &kp N1 &kp N2 &kp N3 &kp N0 &kp SEMI   &kp LSHIFT   &kp EXCL &kp AT &kp HASH &trans &kp ENTER
            >;
        };
        functions {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5        &kp LC(LA(L)) &kp LS(F6) &kp LA(F7) &kp LC(B) &kp LC(LS(A))
                &kp F6 &kp F7 &kp F8 &kp F9 &kp F10       &out OUT_USB &out OUT_BLE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2
                &kp F11 &kp F12 &kp LA(F4) &kp LS(F10) &kp LS(F9)   &kp SPACE   &kp F8 &kp F9 &trans &trans &bootloader
            >;
        };
    };
};
